#!/usr/bin/env python3
"""Keychain double. With no explicit temp store, fail without touching any Keychain."""
import json
import os
import shlex
import sys
from pathlib import Path

path = os.environ.get('ZORUA_TEST_KEYCHAIN')
if not path or os.environ.get('ZORUA_TEST_KEYCHAIN_FAIL'):
    sys.stderr.write('test Keychain unavailable')
    sys.exit(1)
p = Path(path)
data = json.loads(p.read_text()) if p.exists() else {}
a = sys.argv[1:]
if a == ['-i']:
    # Interactive mode: one command per stdin line, quoted the way security splits it.
    a = shlex.split(sys.stdin.readline())
    if a[0] != 'add-generic-password' or sys.stdin.read():
        sys.exit(1)
elif a[0] == 'add-generic-password':
    sys.stderr.write('a password must never be passed in argv')
    sys.exit(2)
account = a[a.index('-a') + 1]
if a[0] == 'add-generic-password':
    data[account] = bytes.fromhex(a[a.index('-X') + 1]).decode()
    p.write_text(json.dumps(data))
    p.chmod(0o600)
elif a[0] == 'find-generic-password' and account in data:
    print(data[account])
else:
    sys.exit(1)
